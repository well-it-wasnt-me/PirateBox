# PirateBox Zero W app settings. Edit, then: sudo systemctl restart piratebox
PIRATEBOX_NAME=PirateBox
PIRATEBOX_DATA_DIR=/var/lib/piratebox/data
PIRATEBOX_DB_PATH=/var/lib/piratebox/data/piratebox.db
PIRATEBOX_FILES_DIR=/var/lib/piratebox/data/files
# 512 MB of RAM and a microSD card. Large uploads are possible, not advisable.
PIRATEBOX_MAX_UPLOAD_MB=256
# Uploads spool here instead of /tmp, which is RAM on trixie, and RAM is the one thing we lack.
TMPDIR=/var/lib/piratebox/tmp
PORT=80
