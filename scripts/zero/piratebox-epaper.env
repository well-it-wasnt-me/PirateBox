# PirateBox Zero W e-paper settings: Waveshare 2.13" e-Paper HAT (B) V4. Black, white, red, no buttons.
# Edit, then: sudo systemctl restart piratebox-epaper
PIRATEBOX_EPD_DRIVER=waveshare_epd
PIRATEBOX_EPD_WAVESHARE_MODULE=epd2in13b_V4
PIRATEBOX_EPD_BUTTON_PINS=none
PIRATEBOX_EPD_PAGES=dashboard
PIRATEBOX_EPD_ORIENTATION=landscape
# 180 if the panel ends up upside down. It will. Hats have no sense of direction.
PIRATEBOX_EPD_ROTATE=0
# Sample stats every minute. The panel itself refreshes at most every 3 minutes, as Waveshare insists.
PIRATEBOX_EPD_INTERVAL=60
PIRATEBOX_EPD_MIN_REFRESH=180
# Redraw at least hourly even when nothing changes, so the uptime is not fiction.
PIRATEBOX_EPD_MAX_AGE=3600
PIRATEBOX_EPD_REFRESH_ON_CHANGE=1
# Negative disables a trigger. CPU and memory wobble constantly; a red flash per wobble is not a feature.
PIRATEBOX_EPD_REFRESH_CPU_DELTA=-1
PIRATEBOX_EPD_REFRESH_MEM_DELTA=-1
PIRATEBOX_EPD_REFRESH_TEMP_DELTA=5
PIRATEBOX_EPD_REFRESH_DISK_DELTA=1
PIRATEBOX_EPD_REFRESH_COUNT_DELTA=1
PIRATEBOX_EPD_REFRESH_IP=1
PIRATEBOX_WIFI_IFACE=wlan0
