# PirateBox e-Paper systemd unit.
# Keep the paper awake so it can report that nothing is on fire.
[Unit]
Description=PirateBox e-Paper status display
# Wait for the AP address when there is one, so the first frame shows a real URL.
After=network.target piratebox-ap-ip.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/piratebox
Environment=PYTHONUNBUFFERED=1
# The app's env first, so the display counts the same database the web app writes to.
EnvironmentFile=-/etc/default/piratebox
EnvironmentFile=-/etc/default/piratebox-epaper
ExecStart=/opt/piratebox/.venv/bin/python /opt/piratebox/scripts/epaper_hat.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
